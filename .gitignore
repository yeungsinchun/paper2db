.venv/
# Python
__pycache__/
*.pyc
.DS_Store

# Generated by ./pipeline from paper/ - rebuild, do not commit
# (see README "Regenerating tests/reconstructed/ and tests/sections/"). Only
# the hand-tuned inputs re-included below stay tracked. output/ and
# reconstructed/ are pre-move trees; stale local copies stay ignored.
# metadata/ (LLM classification decisions) is entirely tracked, not gitignored.
output/
/reconstructed/
/classified/
intermediate/
tests/reconstructed/*
!tests/reconstructed/lq/
tests/reconstructed/lq/*
!tests/reconstructed/lq/*/
tests/reconstructed/lq/*/*
!tests/reconstructed/lq/*/starts.json
tests/sections/
.lavish/
# CI release packaging (scripts/package_release.py)
/dist/
/release-notes.md
/unittest.log
