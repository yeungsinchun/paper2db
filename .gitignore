.venv/
__pycache__/
*.pyc
.DS_Store

# Generated by ./pipeline from paper/ and answer/ - rebuild, do not commit
# (see README "Regenerating output/ and classified/"). reconstructed/ is the
# same tree under its new name on the sibling layout branch. Only the hand-tuned
# inputs re-included below stay tracked.
output/*
!output/lq/
output/lq/*
!output/lq/*/
output/lq/*/*
!output/lq/*/starts.json
reconstructed/*
!reconstructed/lq/
reconstructed/lq/*
!reconstructed/lq/*/
reconstructed/lq/*/*
!reconstructed/lq/*/starts.json
classified/*
!classified/mc/
classified/mc/*
!classified/mc/llm_classifications.json
!classified/lq/
classified/lq/*
!classified/lq/llm_classifications.json
!classified/lq/candidate_performance.json
.lavish/
